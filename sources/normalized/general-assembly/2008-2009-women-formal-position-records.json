    {
      "event_id": "2008-rpr-women-scripture-reading-minority-report",
      "assembly": "36th General Assembly",
      "year": 2008,
      "topic": "women_reading_scripture_and_exhorting_in_public_worship",
      "evidence_class": "signed_formal_report_or_minority_report",
      "official_source_url": "https://pcahistory.org/pca/ga/36th_pcaga_2008.pdf",
      "official_pages": [277],
      "position_summary": "The minority argued that a presbytery view allowing a woman to do in worship anything a non-ordained man may do was an exception of substance, reasoning that 1 Timothy 2 forbids women to teach or exercise authority over men in worship and that reading Scripture or exhorting exercises the authority of the Word of God.",
      "important_boundary": "This records the stated position of the eight named minority-report signers. The majority committee action is recorded only at event level because the minutes do not provide an individual roll-call of the majority on this question.",
      "signer_count": 8,
