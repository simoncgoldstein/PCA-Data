    {
      "event_id": "2009-overture-10-women-roles-study-minority-report",
      "assembly": "37th General Assembly",
      "year": 2009,
      "topic": "women_roles_in_the_church",
      "evidence_class": "signed_formal_report_or_minority_report",
      "official_source_url": "https://www.pcahistory.org/pca/ga/37th_pcaga_2009.pdf",
      "official_pages": [298, 299, 300, 301, 302],
      "position_summary": "The minority recommended answering Overture 10 affirmatively as amended by appointing a study committee representing diverse PCA views, including up to two women advisory members, to produce a pastoral letter on faithful roles for women, useful local practices, accountability to ordained leadership, and whether the BCO unnecessarily hindered use of women's gifts.",
      "important_boundary": "Signership establishes concurrence with this minority report's call for a study committee/pastoral letter and stated grounds. It does not by itself establish a particular view on female ordination or every disputed practice.",
      "assembly_outcome": "Minority report defeated 427-446; Recommendation 8 answering Overture 10 in the negative was adopted.",
